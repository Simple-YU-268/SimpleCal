# Optional overrides for /etc/simplecal/simplecal.env (systemd EnvironmentFile syntax).
CALDAV_USER=admin
# Omit password settings to generate /var/lib/simplecal/admin-initial-password.txt.
# CALDAV_ADMIN_PASSWORD_FILE=/etc/simplecal/admin-password
# Bind to all interfaces for direct LAN access; default service is loopback.
# CALDAV_HOST=0.0.0.0
# Public HTTP(S) origin and optional reverse-proxy path, without a trailing slash.
# CALDAV_PUBLIC_BASE_URL=https://calendar.example.com/simplecal
