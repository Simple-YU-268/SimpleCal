{
  "name": "simplecal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SimpleCal 日历前端（自建 REST + Cookie 会话，零云依赖）。",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
